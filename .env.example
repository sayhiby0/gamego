# Local examples only; never commit .dev.vars or real credentials.
SITE_ORIGIN=http://127.0.0.1:8000

# Backend-only secret, at least 32 random characters; HMAC short-lived Key/IP limits.
RATE_LIMIT_SECRET=
# The backend and trusted collector share this separate service credential.
CONTENT_SERVICE_TOKEN=

# Backend public budget configuration; paid content needs a durable D1 ledger.
CONTENT_ENABLED=false
CONTENT_MODEL=
CONTENT_PRICE_MODEL=
CONTENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CONTENT_PRICE_VERSION=
CONTENT_INPUT_MICROS_PER_MILLION=
CONTENT_OUTPUT_MICROS_PER_MILLION=

# Collector-only GitHub Actions Secrets; Key is sent in X-Content-API-Key, never in JSON.
CONTENT_API_KEY=
CONTENT_PROCESS_URL=

# Backend allowlist; leave empty until real deployed model/region acceptance succeeds.
AGENT_ENABLED=false
AGENT_MODELS_JSON=[]
# Each item requires region, model, label, verifiedAt (real ISO verification time).
# Regions: cn-beijing, intl-singapore, us-virginia. No arbitrary base URL.
# Optional pricing requires inputMicrosPerMillion, outputMicrosPerMillion, priceVersion together.
# Never put a visitor Key here. AGENT_API_KEY is not used.
PUBLIC_DATA_URL=
